DASHBOARD_FTP_HOST=
DASHBOARD_FTP_USER=
DASHBOARD_FTP_PASSWORD=
DASHBOARD_FTP_DIR=/
DASHBOARD_FTP_TLS=1
HWS_FTP_PASSWORD=

# Optional dashboard thresholds (defaults shown)
DASHBOARD_CAPTURE_WARNING_SECONDS=30
DASHBOARD_CAPTURE_CRITICAL_SECONDS=120
DASHBOARD_DISK_FREE_WARNING_GB=10
DASHBOARD_DISK_FREE_CRITICAL_GB=2
DASHBOARD_DISK_USED_WARNING_PERCENT=85
DASHBOARD_DISK_USED_CRITICAL_PERCENT=95
DASHBOARD_CPU_TEMP_WARNING_C=70
DASHBOARD_CPU_TEMP_CRITICAL_C=80
DASHBOARD_MEMORY_WARNING_PERCENT=85
DASHBOARD_MEMORY_CRITICAL_PERCENT=95
DASHBOARD_HEALTH_STALE_SECONDS=7200
DASHBOARD_STALE_MINUTES=15
# Location for sunrise/sunset lines and timelapse preview size limit (0 disables preview)
DASHBOARD_LATITUDE=51.8175
DASHBOARD_LONGITUDE=-0.352
DASHBOARD_TIMELAPSE_MAX_MB=150

# Optional weather-station JSON read by the camera for overlay/status (see README)
# HWS_WEATHER_DATA_PATH=/mnt/weathercam/logs/weather_station.json
# Weather Display clientraw.txt fetched by weathercam-weather-station.service
# HWS_WEATHER_HISTORY_PATH=/mnt/weathercam/logs/weather_station_history.json
# HWS_WEATHER_SERIES_PATH=/mnt/weathercam/logs/weather_station_series.json
# HWS_WEATHER_RAW_PATH=/mnt/weathercam/logs/weather_station_raw.json
# HWS_WEATHER_COMPARE_PATH=/mnt/weathercam/logs/weather_station_compare.json
# HWS_WEATHER_MINUTE_PATH=/mnt/weathercam/logs/weather_station_minute.json
# HWS_WEATHER_DAILY_LOG_PATH=/mnt/weathercam/logs/weather_station_daily_log.json
# Set 0 to keep gust/solar/UV/lightning off the camera image overlay
# HWS_OVERLAY_STATION_EXTRAS=1

# Weekly/monthly timelapses are always created and kept; set 0 to stop uploading them (daily upload is unaffected).
# HWS_UPLOAD_WEEKLY_TIMELAPSE=1
# HWS_UPLOAD_MONTHLY_TIMELAPSE=1
# Read the Meteobridge directly (host or template.cgi URL); clientraw below becomes the fallback
# HWS_METEOBRIDGE_URL=192.168.0.65
# Meteobridge login (user defaults to 'meteobridge'); needed if the web interface asks for a password
# Set 0 to stop fetching the clientraw files and use only the Meteobridge (local history builds up from the Meteobridge readings)
# HWS_CLIENTRAW_ENABLED=1
# HWS_METEOBRIDGE_USER=meteobridge
# HWS_METEOBRIDGE_PASSWORD=
# CLIENTRAW_URL=http://www.harpendenweatherstation.co.uk/Live/clientraw.txt

# Live weather strip: the weather service uploads a small weather-live.json every N seconds (0 = off; the page polls it every minute)
# HWS_LIVE_UPLOAD_SECONDS=120
# HWS_WEATHER_LIVE_PATH=/mnt/weathercam/logs/weather_live.json

# Forecast (MET Norway, the data behind yr.no), fetched by the dashboard. Set 0 to switch it off.
# DASHBOARD_FORECAST=1
# DASHBOARD_FORECAST_REFRESH_MINUTES=60
# Optional JSON file overriding the About/Station page text (site_name, tagline, about[], station{}, links[{title,url}])
# DASHBOARD_SITE_CONTENT=/etc/weathercam/site_content.json
# JSON keys: site_name, tagline, about[], station{}, links[{title,url}], news[{date,text}], donate, radar_rain, radar_satellite (https URLs for the radar page)
# Where the camera's timelapse/keogram files live relative to the dashboard pages (a URL or path ending in /); empty = same folder.
# DASHBOARD_MEDIA_BASE=

# Weather alerts (frost, strong gusts, heavy rain). Set an email and/or ntfy target; each alert is sent at most once every 6 hours.
#DASHBOARD_ALERT_SMTP_HOST=smtp.example.com
#DASHBOARD_ALERT_SMTP_PORT=587
#DASHBOARD_ALERT_SMTP_USER=
#DASHBOARD_ALERT_SMTP_PASSWORD=
#DASHBOARD_ALERT_FROM=alerts@example.com
#DASHBOARD_ALERT_TO=info@harpendenweatherstation.co.uk
#DASHBOARD_ALERT_NTFY_URL=https://ntfy.sh/your-private-topic
#DASHBOARD_ALERT_FROST_C=0
#DASHBOARD_ALERT_GUST_MPH=40
#DASHBOARD_ALERT_RAIN_RATE_MM_H=10
