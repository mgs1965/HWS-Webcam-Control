      "source": [
        "import os, shutil, subprocess, zipfile\n",
        "from pathlib import Path\n",
        "\n",
        "root = Path('/vscode-vfs/github/mgs1965/HWS-Webcam-Control')\n",
        "os.chdir(root)\n",
        "\n",
        "verify = subprocess.run(['python3', 'verify_v50.py'], capture_output=True, text=True)\n",
        "print(verify.stdout)\n",
        "print(verify.stderr)\n",
        "verify.check_returncode()\n",
        "\n",
        "staging = root / 'HarpendenWeatherCamera-V50'\n",
        "archive = root / 'HarpendenWeatherCamera-V50.zip'\n",
        "if staging.exists():\n",
        "    shutil.rmtree(staging)\n",
        "if archive.exists():\n",
        "    archive.unlink()\n",
        "staging.mkdir()\n",
        "\n",
        "items = [\n+        "ARCHITECTURE.md", "CHANGELOG.md", "DEPLOYMENT.md", "MAPPING.md", "README.md",
        "camera.py", "controller_analytics.py", "core.py", "dashboard.env.example",
        "exposure.py", "image_quality.py", "install_v50.sh", "loader.py", "manifest.json",
        "modes.py", "monitoring.py", "publishing.py", "rollback_v50.sh", "runtime.py",
        "state.py", "systemd", "timelapse.py", "v47_control.py", "verify_v50.py",
        "version.py", "weather_camera.py", "weathercam_dashboard"
        ]\n",
        "for item in items:\n",
        "    source = root / item\n",
        "    target = staging / item\n",
        "    if source.is_dir():\n",
        "        shutil.copytree(source, target)\n",
        "    else:\n",
        "        shutil.copy2(source, target)\n",
        "\n",
        "for script in ('verify_v50.py', 'install_v50.sh', 'rollback_v50.sh'):\n",
        "    (staging / script).chmod((staging / script).stat().st_mode | 0o111)\n",
        "\n",
        "with zipfile.ZipFile(archive, 'w', compression=zipfile.ZIP_DEFLATED) as package:\n",
        "    for file in staging.rglob('*'):\n",
        "        if file.is_file():\n",
        "            package.write(file, file.relative_to(root).as_posix())\n",
        "\n",
        "with zipfile.ZipFile(archive, 'r') as package:\n",
        "    bad = package.testzip()\n",
        "    print({'archive': str(archive), 'entries': len(package.namelist()), 'bad_entry': bad})"
      ]
    }
  ],
