[Unit]
Description=Harpenden Weather Camera clientraw weather-station fetcher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
User=mgs
WorkingDirectory=/mnt/weathercam/app/current
EnvironmentFile=/etc/weathercam/dashboard.env
ExecStartPre=/bin/sh -c 'test -n "$CLIENTRAW_URL" -o -n "$HWS_METEOBRIDGE_URL" || { echo "Set CLIENTRAW_URL or HWS_METEOBRIDGE_URL in /etc/weathercam/dashboard.env" >&2; exit 1; }'
ExecStart=/usr/bin/python3 /mnt/weathercam/app/current/weather_station.py --interval 60
Restart=on-failure
RestartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
